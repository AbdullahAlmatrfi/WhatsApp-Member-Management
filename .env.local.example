# Supabase keys — copy this file to ".env.local" and fill in your two values.
# Get them from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: used by app/api/admin-users (staff account management). Set in Netlify env too.
# SUPABASE_SERVICE_ROLE_KEY=   (server-only — never prefix with NEXT_PUBLIC)
